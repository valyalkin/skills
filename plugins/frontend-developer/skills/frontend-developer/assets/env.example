# Copy to .env.local and fill in. Never commit .env.local.
# Every variable here must also appear in app/lib/env.ts and vitest.setup.ts.

# The separate backend API
API_BASE_URL=http://localhost:4000

# Auth0 (Regular Web Application)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# The API identifier from the Auth0 dashboard; without it Auth0 issues no API token
AUTH0_AUDIENCE=https://api.example.com
APP_BASE_URL=http://localhost:3000
